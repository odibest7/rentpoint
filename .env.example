# Copy this file to .env and adjust values for your environment.
# See docs/RUNBOOK.md for a full explanation of every variable.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database: leave DB_ENGINE unset (or "sqlite") for local development.
# Set DB_ENGINE=mysql and fill in the rest to use MySQL in production.
DB_ENGINE=sqlite
DB_NAME=rentpoint
DB_USER=rentpoint
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Platform / business settings
PLATFORM_NAME=RentPoint
PLATFORM_SERVICE_AREA=Nsukka Urban
PLATFORM_COMMISSION_PERCENT=8
MINIMUM_WITHDRAWAL_AMOUNT=1000

# Payment gateway (leave as "mock" until a real provider is integrated)
PAYMENT_GATEWAY_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
