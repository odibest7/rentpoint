# ============================================================
# RentPoint — Environment Variables
# Copy this file to .env and fill in the values for your
# environment. Never commit the real .env file to version
# control.
# See docs/RUNBOOK.md §4 for a full explanation of every
# variable.
# ============================================================


# ------------------------------------------------------------
# Django core
# ------------------------------------------------------------

# These values are used to create or sync the seeded admin account when
# running the project seed commands in local development or Render.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisStrongPassword

# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# Set to False in production. Leave True for local development.
DJANGO_DEBUG=True

# LOCAL:  127.0.0.1,localhost
# PRODUCTION: add your real domain, e.g.:
#   DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,rentpoint.onrender.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Required when your app runs behind an HTTPS proxy (Render, Railway, Fly.io, etc.)
# It must match the exact scheme + domain your users visit, e.g.:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://rentpoint.onrender.com,https://www.yourdomain.com
# Leave empty for local development (http://127.0.0.1:8000 is trusted automatically).
DJANGO_CSRF_TRUSTED_ORIGINS=


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# DB_ENGINE options:
#   sqlite   — zero-config local development (default, no other DB_* vars needed)
#   postgres — free cloud databases: Supabase, Railway, Neon, ElephantSQL
#   mysql    — shared hosting or PlanetScale
#
# EASIEST FREE OPTION FOR PRODUCTION: Supabase PostgreSQL
#   1. Go to https://supabase.com  and create a free project.
#   2. In Project Settings > Database, copy the "Connection string" (URI format).
#   3. Set DB_ENGINE=postgres and paste the URI into DATABASE_URL below.
#      (You can also fill in the individual DB_* variables instead.)

DB_ENGINE=sqlite

# Option A: paste the full connection string from Supabase / Railway / Neon
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: individual variables (used when DATABASE_URL is not set)
DB_NAME=rentpoint
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Set to "require" for cloud PostgreSQL (default in production mode).
# Set to "disable" only if your host does not support SSL (rare).
DB_SSLMODE=require


# ------------------------------------------------------------
# Platform / business settings
# ------------------------------------------------------------
PLATFORM_NAME=RentPoint
PLATFORM_SERVICE_AREA=Nsukka Urban
PLATFORM_COMMISSION_PERCENT=8
MINIMUM_WITHDRAWAL_AMOUNT=1000


# ------------------------------------------------------------
# Payment gateway
# ------------------------------------------------------------
# Paystack is the only active payment provider for this project.
# Provide only the public and secret keys below.
#
# How to get Paystack API keys:
#   1. Sign up at https://paystack.com
#   2. Go to Settings > API Keys & Webhooks
#   3. Copy your Secret Key (sk_live_... for live, sk_test_... for testing)
#   4. Copy your Public Key (pk_live_... for live, pk_test_... for testing)
#
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=


# ------------------------------------------------------------
# Email & Password Reset (See docs/email.md for 100% free setup)
# ------------------------------------------------------------
# For local development: leave empty to log emails to console.
# For production (100% Free Forever via Gmail App Password):
#   1. Enable 2-Step Verification on your Google Account
#   2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
#   3. Fill in the values below:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RentPoint <no-reply@rentpoint.ng>

